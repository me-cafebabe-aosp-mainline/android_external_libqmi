// ---------------------------------------------------------------------------
// Filegroups for input headers used by qmi-mkenums genrules (in Android.gen.bp)
// ---------------------------------------------------------------------------

filegroup {
    name: "qmi_errors_header",
    srcs: ["qmi-errors.h"],
}

filegroup {
    name: "qmi_enums_headers",
    srcs: [
        "qmi-device.h",
        "qmi-enums.h",
        "qmi-enums-dms.h",
        "qmi-enums-dsd.h",
        "qmi-enums-fox.h",
        "qmi-enums-gas.h",
        "qmi-enums-ims.h",
        "qmi-enums-imsa.h",
        "qmi-enums-imsp.h",
        "qmi-enums-imsdcm.h",
        "qmi-enums-loc.h",
        "qmi-enums-nas.h",
        "qmi-enums-oma.h",
        "qmi-enums-pbm.h",
        "qmi-enums-pdc.h",
        "qmi-enums-pds.h",
        "qmi-enums-qos.h",
        "qmi-enums-sar.h",
        "qmi-enums-uim.h",
        "qmi-enums-voice.h",
        "qmi-enums-wda.h",
        "qmi-enums-wds.h",
        "qmi-enums-wms.h",
        "qmi-enums-ssc.h",
    ],
}

filegroup {
    name: "qmi_enums_private_header",
    srcs: ["qmi-enums-private.h"],
}

filegroup {
    name: "qmi_flags64_headers",
    srcs: [
        "qmi-flags64-dms.h",
        "qmi-flags64-dsd.h",
        "qmi-flags64-loc.h",
        "qmi-flags64-nas.h",
        "qmi-flags64-wds.h",
    ],
}

// ---------------------------------------------------------------------------
// Version header generation
// ---------------------------------------------------------------------------

genrule {
    name: "gen_qmi_version_h",
    srcs: ["qmi-version.h.in"],
    out: ["qmi-version.h"],
    cmd: "sed " +
         "-e 's|@QMI_MAJOR_VERSION@|1|g' " +
         "-e 's|@QMI_MINOR_VERSION@|39|g' " +
         "-e 's|@QMI_MICRO_VERSION@|1|g' " +
         "-e 's|@QMI_MBIM_QMUX_SUPPORTED@|0|g' " +
         "-e 's|@QMI_QRTR_SUPPORTED@|0|g' " +
         "-e 's|@QMI_RMNET_SUPPORTED@|1|g' " +
         "$(in) > $(out)",
}

