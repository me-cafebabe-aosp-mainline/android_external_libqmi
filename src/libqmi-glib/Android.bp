// ---------------------------------------------------------------------------
// Static library: compat code (qmi-compat.c with special flags)
// ---------------------------------------------------------------------------

cc_library_static {
    name: "libqmi-glib-compat",
    defaults: [
        "libqmi_common_dep_defaults",
    ],
    srcs: ["qmi-compat.c"],
    cflags: [
        "-DLIBQMI_GLIB_COMPILATION",
        "-DG_LOG_DOMAIN=\"Qmi\"",
        "-Wno-deprecated-declarations",
        "-UQMI_DISABLE_DEPRECATED",
    ],
    local_include_dirs: ["."],
    header_libs: ["libqmi_top_headers"],
    generated_headers: all_generated_headers,
}

// ---------------------------------------------------------------------------
// Static library: generated code (mkenums + codegen outputs)
// ---------------------------------------------------------------------------

cc_library_static {
    name: "libqmi-glib-generated",
    defaults: [
        "libqmi_common_dep_defaults",
    ],
    generated_sources: all_generated_sources,
    generated_headers: all_generated_headers,
    cflags: [
        "-DLIBQMI_GLIB_COMPILATION",
        "-DG_LOG_DOMAIN=\"Qmi\"",
        "-Wno-unused-function",
    ],
    local_include_dirs: ["."],
    header_libs: ["libqmi_top_headers"],
}

// ---------------------------------------------------------------------------
// Shared library: libqmi-glib
// ---------------------------------------------------------------------------

cc_library_shared {
    name: "libqmi-glib",
    defaults: [
        "libqmi_common_dep_defaults",
    ],
    srcs: [
        "qmi-client.c",
        "qmi-device.c",
        "qmi-endpoint.c",
        "qmi-endpoint-qmux.c",
        "qmi-enums-dms.c",
        "qmi-enums-nas.c",
        "qmi-enums-wds.c",
        "qmi-file.c",
        "qmi-helpers.c",
        "qmi-message.c",
        "qmi-message-context.c",
        "qmi-net-port-manager.c",
        "qmi-net-port-manager-qmiwwan.c",
        "qmi-net-port-manager-rmnet.c",
        "qmi-proxy.c",
        "qmi-utils.c",
    ],
    whole_static_libs: [
        "libqmi-glib-compat",
        "libqmi-glib-generated",
    ],
    cflags: [
        "-DLIBQMI_GLIB_COMPILATION",
        "-DG_LOG_DOMAIN=\"Qmi\"",
        "-DLIBEXEC_PATH=\"/vendor/bin\"",
    ],
    generated_headers: all_generated_headers,
    local_include_dirs: ["."],
    header_libs: ["libqmi_top_headers"],
    export_include_dirs: ["."],
    export_generated_headers: public_generated_headers,
    vendor_available: true,
}
