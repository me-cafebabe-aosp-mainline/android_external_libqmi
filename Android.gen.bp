// ---------------------------------------------------------------------------
// qmi-codegen generated files
//
// qmi-codegen writes 3 files per service (.c, .h, .md) in a single invocation.
// Soong's generated_sources rejects .h files and unknown extensions (.md), so
// each service is split into two genrules: one producing only .c (deleting .h/.md)
// and one producing only .h (deleting .c/.md). The .md files (docs) are discarded.
// ---------------------------------------------------------------------------

genrule {
    name: "gen_qmi_ctl_c",
    srcs: [
        "data/qmi-service-ctl.json",
        "data/qmi-common.json",
    ],
    tool_files: codegen_tool_files,
    out: ["qmi-ctl.c"],
    cmd: "PYTHONPATH=$$(dirname $(location build-aux/qmi-codegen/qmi-codegen)) " +
         "python3 $(location build-aux/qmi-codegen/qmi-codegen) " +
         "--input $(location data/qmi-service-ctl.json) " +
         "--include $(location data/qmi-common.json) " +
         "--output $(genDir)/qmi-ctl && " +
         "rm -f $(genDir)/qmi-ctl.h $(genDir)/qmi-ctl.md",
}

genrule {
    name: "gen_qmi_ctl_h",
    srcs: [
        "data/qmi-service-ctl.json",
        "data/qmi-common.json",
    ],
    tool_files: codegen_tool_files,
    out: ["qmi-ctl.h"],
    cmd: "PYTHONPATH=$$(dirname $(location build-aux/qmi-codegen/qmi-codegen)) " +
         "python3 $(location build-aux/qmi-codegen/qmi-codegen) " +
         "--input $(location data/qmi-service-ctl.json) " +
         "--include $(location data/qmi-common.json) " +
         "--output $(genDir)/qmi-ctl && " +
         "rm -f $(genDir)/qmi-ctl.c $(genDir)/qmi-ctl.md",
}

