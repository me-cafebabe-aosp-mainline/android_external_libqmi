genrule {
    name: "gen_qmi_ctl",
    srcs: [
        "data/qmi-service-ctl.json",
        "data/qmi-common.json",
    ],
    tool_files: codegen_tool_files,
    out: [
        "qmi-ctl.c",
        "qmi-ctl.h",
        "qmi-ctl.md",
    ],
    cmd: "PYTHONPATH=$$(dirname $(location build-aux/qmi-codegen/qmi-codegen)) " +
         "python3 $(location build-aux/qmi-codegen/qmi-codegen) " +
         "--input $(location data/qmi-service-ctl.json) " +
         "--include $(location data/qmi-common.json) " +
         "--output $(genDir)/qmi-ctl",
}

