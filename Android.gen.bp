// Auto-generated code build rules for libqmi-glib

codegen_tool_files = [
    "build-aux/qmi-codegen/qmi-codegen",
    "build-aux/qmi-codegen/Client.py",
    "build-aux/qmi-codegen/Container.py",
    "build-aux/qmi-codegen/Field.py",
    "build-aux/qmi-codegen/FieldResult.py",
    "build-aux/qmi-codegen/Message.py",
    "build-aux/qmi-codegen/MessageList.py",
    "build-aux/qmi-codegen/TypeFactory.py",
    "build-aux/qmi-codegen/utils.py",
    "build-aux/qmi-codegen/Variable.py",
    "build-aux/qmi-codegen/VariableArray.py",
    "build-aux/qmi-codegen/VariableFactory.py",
    "build-aux/qmi-codegen/VariableInteger.py",
    "build-aux/qmi-codegen/VariableSequence.py",
    "build-aux/qmi-codegen/VariableString.py",
    "build-aux/qmi-codegen/VariableStruct.py",
]

// ---------------------------------------------------------------------------
// qmi-mkenums generated files
// ---------------------------------------------------------------------------

genrule {
    name: "gen_qmi_error_types_h",
    srcs: [":qmi_errors_header"],
    tool_files: [
        "build-aux/qmi-mkenums",
        "build-aux/templates/qmi-error-types.h.template",
    ],
    out: ["qmi-error-types.h"],
    cmd: "python3 $(location build-aux/qmi-mkenums) " +
         "--fhead '#ifndef __LIBQMI_GLIB_ERROR_TYPES_H__\\n" +
         "#define __LIBQMI_GLIB_ERROR_TYPES_H__\\n" +
         "#include \"qmi-errors.h\"\\n' " +
         "--template $(location build-aux/templates/qmi-error-types.h.template) " +
         "--ftail '#endif /* __LIBQMI_GLIB_ERROR_TYPES_H__ */\\n' " +
         "$(in) > $(out)",
}

genrule {
    name: "gen_qmi_error_types_c",
    srcs: [":qmi_errors_header"],
    tool_files: [
        "build-aux/qmi-mkenums",
        "build-aux/templates/qmi-error-types.c.template",
    ],
    out: ["qmi-error-types.c"],
    cmd: "python3 $(location build-aux/qmi-mkenums) " +
         "--fhead '#include \"qmi-errors.h\"\\n" +
         "#include \"qmi-error-types.h\"\\n' " +
         "--template $(location build-aux/templates/qmi-error-types.c.template) " +
         "$(in) > $(out)",
}

