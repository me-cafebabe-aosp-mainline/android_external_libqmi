    "build-aux/qmi-codegen/VariableArray.py",
    "build-aux/qmi-codegen/VariableFactory.py",
    "build-aux/qmi-codegen/VariableInteger.py",
    "build-aux/qmi-codegen/VariableSequence.py",
    "build-aux/qmi-codegen/VariableString.py",
    "build-aux/qmi-codegen/VariableStruct.py",
]

